# ----------------------------------------------------------------------------
# UCL Campus Hub - environment variables.  Copy to .env.local and fill in.
# Full explanation of every variable: docs/ENVIRONMENT.md
# Anything starting with NEXT_PUBLIC_ is visible in the browser. Nothing secret
# ever goes in a NEXT_PUBLIC_ variable.
# ----------------------------------------------------------------------------

# --- Backend mode ------------------------------------------------------------
# "firebase" = real Firebase project or the emulators. "memory" = self-contained
# demo mode: data lives in the browser, no Firebase or keys needed.
NEXT_PUBLIC_BACKEND=memory

# --- Firebase web app config (public; copy from Firebase console > Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Point the browser at the local emulators (npm run emulators). Leave "false" for a real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Optional: only allow registration from these email domains (comma separated), e.g. ucl.ac.lk
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=

# Show the one-click demo accounts on the sign-in page. Always on in memory mode.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false

# --- Server only (Firebase Admin SDK) - SECRET, never commit real values --------
# Used by the API routes (AI assistant, account management) and `npm run seed`.
# Create a service account: Firebase console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n sequences exactly as in the downloaded JSON file.
FIREBASE_PRIVATE_KEY=

# --- AI assistant (server only) ----------------------------------------------
# mock (default; no key, answers straight from campus data) | anthropic | gemini | openai
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
# Only for OpenAI-compatible services; defaults to https://api.openai.com/v1
AI_BASE_URL=
